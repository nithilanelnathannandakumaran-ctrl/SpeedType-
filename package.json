{
  "name": "speedtype-workers",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SpeedType - Cloudflare Workers + D1 edition.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 execute speedtype-db --remote --file=./schema.sql",
    "db:migrate:local": "wrangler d1 execute speedtype-db --local --file=./schema.sql"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
